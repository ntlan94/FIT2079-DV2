{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 15 Australian Postcodes by Solar Installations",
    "anchor": "start",
    "color": "#2c3e50"
  },
  "width": 800,
  "height": 500,
  "data": {
    "url": "data/sgu-solar-installations.csv",
    "format": {
      "type": "csv",
      "parse": {"Postcode": "string", "Total": "number"}
    }
  },
  "transform": [
    {"filter": "datum.Total > 0"},
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "Total", "order": "descending"}]
    },
    {"filter": "datum.rank <= 15"},
    {"calculate": "950", "as": "baseline"}
  ],
  "encoding": {
    "y": {
      "field": "Postcode",
      "type": "nominal",
      "sort": {"field": "Total", "order": "descending"},
      "title": "Postcode",
      "axis": {
        "grid": true,
        "gridDash": [4, 4],
        "gridColor": "#e0e0e0"
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "color": "#f39c12", "strokeWidth": 3, "opacity": 0.5},
      "encoding": {
        "x": {"field": "baseline", "type": "quantitative"},
        "x2": {"field": "Total"}
      }
    },
    {
      "mark": {"type": "circle", "size": 400, "color": "#1a1918"},
      "encoding": {
        "x": {
          "field": "Total",
          "type": "quantitative",
          "title": "Total Installations",
          "scale": {"domainMin": 950},
          "axis": {"format": ","}
        },
        "tooltip": [
          {"field": "Postcode", "type": "nominal"},
          {"field": "Total", "type": "quantitative", "format": ",", "title": "Total Installations"}
        ]
      }
    }
  ],
  "config": {
    "font": "Helvetica Neue, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#2c3e50",
      "subtitleFontSize": 13,
      "subtitleColor": "#7f8c8d",
      "offset": 15
    },
    "axis": {
      "titleFontSize": 13,
      "labelFontSize": 12,
      "titleColor": "#444",
      "labelColor": "#666",
      "gridColor": "#e0e0e0"
    },
    "legend": {
      "titleFontSize": 13,
      "labelFontSize": 12,
      "titleColor": "#444",
      "labelColor": "#666"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
