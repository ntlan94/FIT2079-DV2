{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 15 Australian Postcodes by Solar Installations",
    "anchor": "start",
    "color": "#2c3e50"
  },
  "width": 1100,
  "height": 350,
  "data": {
    "url": "data/sgu-solar-installations.csv",
    "format": {
      "type": "csv",
      "parse": {"Postcode": "string", "Total": "number"}
    }
  },
  "transform": [
    {"filter": "datum.Total > 0"},
    {"calculate": "length(datum.Postcode) == 3 ? '0' + datum.Postcode : datum.Postcode", "as": "PC_pad"},
    {"calculate": "toNumber(datum.Postcode)", "as": "p_num"},
    {"calculate": "datum.p_num >= 3000 && datum.p_num <= 3999 || datum.p_num >= 8000 && datum.p_num <= 8999 ? 'VIC ' + datum.PC_pad : datum.p_num >= 4000 && datum.p_num <= 4999 || datum.p_num >= 9000 && datum.p_num <= 9999 ? 'QLD ' + datum.PC_pad : datum.p_num >= 5000 && datum.p_num <= 5999 ? 'SA ' + datum.PC_pad : datum.p_num >= 6000 && datum.p_num <= 6999 ? 'WA ' + datum.PC_pad : datum.p_num >= 7000 && datum.p_num <= 7999 ? 'TAS ' + datum.PC_pad : datum.p_num >= 800 && datum.p_num <= 999 ? 'NT ' + datum.PC_pad : 'NSW ' + datum.PC_pad", "as": "Postcode_Label"},
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "Total", "order": "descending"}]
    },
    {"filter": "datum.rank <= 15"},
    {"calculate": "950", "as": "baseline"}
  ],
  "encoding": {
    "y": {
      "field": "Postcode_Label",
      "type": "nominal",
      "sort": {"field": "Total", "order": "descending"},
      "title": "Postcode",
      "axis": {
        "grid": true,
        "gridDash": [4, 4],
        "gridColor": "#e0e0e0"
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "color": "#f39c12", "strokeWidth": 3, "opacity": 0.5},
      "encoding": {
        "x": {"field": "baseline", "type": "quantitative"},
        "x2": {"field": "Total"}
      }
    },
    {
      "mark": {"type": "circle", "size": 400, "color": "#1a1918"},
      "encoding": {
        "x": {
          "field": "Total",
          "type": "quantitative",
          "title": "Total Installations",
          "scale": {"domainMin": 950},
          "axis": {"format": ",.0f"}
        },
        "tooltip": [
          {"field": "Postcode_Label", "type": "nominal", "title": "Location"},
          {"field": "Total", "type": "quantitative", "format": ",", "title": "Total Installations"}
        ]
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "fontSize": 24,
      "subtitleFontSize": 16,
      "fontWeight": "bold",
      "anchor": "start"
    },
    "axis": {
      "titleFontSize": 16,
      "titleFontWeight": "bold",
      "labelFontSize": 14
    },
    "legend": {
      "titleFontSize": 16,
      "titleFontWeight": "bold",
      "labelFontSize": 14
    },
    "header": {
      "titleFontSize": 18,
      "titleFontWeight": "bold",
      "labelFontSize": 16
    },
    "mark": {
      "fontSize": 14
    }
  }
}
