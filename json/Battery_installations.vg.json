{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": {
    "text": "Historical Battery Installations by State (2014 - 2025)",
    "subtitle": "Click on a State in the legend to isolate its trend line.",
    "anchor": "start",
    "color": "#2c3e50"
  },
  "data": {
    "url": "data/historical-battery-installation.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "fold": ["ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"],
      "as": ["State", "Installations"]
    },
    {
      "calculate": "toNumber(replace(datum.Installations, ',', ''))",
      "as": "Installations_Count"
    },
    {
      "filter": "isValid(datum.Installations_Count)"
    },
    {
      "calculate": "datum.State == 'ACT' ? 'NSW' : datum.State",
      "as": "State"
    },
    {
      "aggregate": [{"op": "sum", "field": "Installations_Count", "as": "Installations_Count"}],
      "groupby": ["Installation year", "State"]
    }
  ],
  "params": [
    {
      "name": "State_Selection",
      "select": {"type": "point", "fields": ["State"]},
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "line",
    "point": true,
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "Installation year",
      "timeUnit": "year",
      "type": "temporal",
      "title": "Year",
      "axis": {"grid": false, "format": "%Y"}
    },
    "y": {
      "field": "Installations_Count",
      "type": "quantitative",
      "title": "Number of Installations",
      "axis": {
        "format": ",.0f"
      }
    },
    "color": {
      "field": "State",
      "type": "nominal",
      "scale": {
        "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "NT"],
        "range": ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b", "#7f7f7f"]
      }
    },
    "opacity": {
      "condition": {"param": "State_Selection", "value": 1},
      "value": 0.1
    },
    "tooltip": [
      {"field": "Installation year", "timeUnit": "year", "type": "temporal", "title": "Year", "format": "%Y"},
      {"field": "State", "type": "nominal"},
      {"field": "Installations_Count", "type": "quantitative", "title": "Total Systems", "format": ","}
    ]
  },
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "fontSize": 24,
      "subtitleFontSize": 16,
      "fontWeight": "bold",
      "anchor": "start"
    },
    "axis": {
      "titleFontSize": 16,
      "titleFontWeight": "bold",
      "labelFontSize": 14
    },
    "legend": {
      "titleFontSize": 16,
      "titleFontWeight": "bold",
      "labelFontSize": 14
    },
    "header": {
      "titleFontSize": 18,
      "titleFontWeight": "bold",
      "labelFontSize": 16
    },
    "mark": {
      "fontSize": 14
    }
  }
}
