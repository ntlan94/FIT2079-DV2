{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Beyond Solar: Small-Scale Wind vs. Hydro Adoption",
    "subtitle": "National distribution by State (Extracted dynamically from Postcodes)",
    "anchor": "start",
    "color": "#2c3e50"
  },
  "hconcat": [
    {
      "width": 180,
      "height": 280,
      "title": {"text": "Wind Power Installations", "color": "#34495e", "anchor": "middle"},
      "data": {
        "url": "data/sgu-wind-installations.csv",
        "format": {"type": "csv", "parse": {"Postcode": "string", "Total": "number"}}
      },
      "transform": [
        {"calculate": "toString(datum.Postcode)", "as": "PC"},
        {"calculate": "length(datum.PC) == 3 ? '0' + datum.PC : datum.PC", "as": "PC_pad"},
        {"calculate": "datum.PC_pad[0] == '0' ? 'NT' : datum.PC_pad[0] == '2' ? 'NSW' : datum.PC_pad[0] == '3' ? 'VIC' : datum.PC_pad[0] == '4' ? 'QLD' : datum.PC_pad[0] == '5' ? 'SA' : datum.PC_pad[0] == '6' ? 'WA' : datum.PC_pad[0] == '7' ? 'TAS' : 'Other'", "as": "State"},
        {"aggregate": [{"op": "sum", "field": "Total", "as": "Total_Qty"}], "groupby": ["State"]}
      ],
      "mark": {"type": "arc", "innerRadius": 40, "padAngle": 0.03, "cornerRadius": 4},
      "encoding": {
        "theta": {"field": "Total_Qty", "type": "quantitative"},
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "NT"],
            "range": ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b", "#7f7f7f"]
          },
          "legend": {"title": "State / Territory", "orient": "bottom", "columns": 4}
        },
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "Total_Qty", "type": "quantitative", "title": "Wind Systems Installed", "format": ","}
        ]
      }
    },
    {
      "width": 180,
      "height": 280,
      "title": {"text": "Hydro Power Installations", "color": "#34495e", "anchor": "middle"},
      "data": {
        "url": "data/sgu-hydro-installations.csv",
        "format": {"type": "csv", "parse": {"Postcode": "string", "Total": "number"}}
      },
      "transform": [
        {"calculate": "toString(datum.Postcode)", "as": "PC"},
        {"calculate": "length(datum.PC) == 3 ? '0' + datum.PC : datum.PC", "as": "PC_pad"},
        {"calculate": "datum.PC_pad[0] == '0' ? 'NT' : datum.PC_pad[0] == '2' ? 'NSW' : datum.PC_pad[0] == '3' ? 'VIC' : datum.PC_pad[0] == '4' ? 'QLD' : datum.PC_pad[0] == '5' ? 'SA' : datum.PC_pad[0] == '6' ? 'WA' : datum.PC_pad[0] == '7' ? 'TAS' : 'Other'", "as": "State"},
        {"aggregate": [{"op": "sum", "field": "Total", "as": "Total_Qty"}], "groupby": ["State"]}
      ],
      "mark": {"type": "arc", "innerRadius": 40, "padAngle": 0.03, "cornerRadius": 4},
      "encoding": {
        "theta": {"field": "Total_Qty", "type": "quantitative"},
        "color": {
          "field": "State",
          "type": "nominal",
          "scale": {
            "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "NT"],
            "range": ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b", "#7f7f7f"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "Total_Qty", "type": "quantitative", "title": "Hydro Systems Installed", "format": ","}
        ]
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "title": {
      "fontSize": 24,
      "subtitleFontSize": 16,
      "fontWeight": "bold",
      "anchor": "start"
    },
    "axis": {
      "titleFontSize": 16,
      "titleFontWeight": "bold",
      "labelFontSize": 14
    },
    "legend": {
      "titleFontSize": 16,
      "titleFontWeight": "bold",
      "labelFontSize": 14
    },
    "header": {
      "titleFontSize": 18,
      "titleFontWeight": "bold",
      "labelFontSize": 16
    },
    "mark": {
      "fontSize": 14
    }
  }
}
