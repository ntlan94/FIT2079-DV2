{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Independent Trajectories: Battery Growth",
    "subtitle": "Independent Y-axes allow fair comparison of growth curves.",
    "anchor": "start"
  },
  "data": {
    "url": "data/historical-battery-installation.csv",
    "format": {
      "type": "csv",
      "parse": {"Installation year": "date"}
    }
  },
  "transform": [
    {
      "fold": ["ACT", "NSW", "NT", "QLD", "SA", "TAS", "VIC", "WA"],
      "as": ["State", "Raw_Installations"]
    },
    {
      "calculate": "toNumber(replace(toString(datum.Raw_Installations), /,/g, ''))",
      "as": "Installations"
    },
    {
      "filter": "isValid(datum.Installations)"
    }
  ],
  "columns": 4,
  "facet": {
    "field": "State",
    "type": "nominal",
    "title": null,
    "header": {
      "labelFontSize": 14,
      "labelFontWeight": "bold"
    }
  },
  "spec": {
    "width": 120,
    "height": 100,
    "layer": [
      {
        "mark": {
          "type": "area",
          "opacity": 0.5
        },
        "encoding": {
          "x": {
            "field": "Installation year",
            "timeUnit": "year",
            "type": "temporal",
            "title": null,
            "axis": {
              "grid": false,
              "format": "%Y",
              "labelAngle": -45,
              "tickCount": 3
            }
          },
          "y": {
            "field": "Installations",
            "type": "quantitative",
            "title": null,
            "axis": {
              "grid": true,
              "gridDash": [4, 4],
              "tickCount": 3
            }
          },
          "tooltip": [
            {"field": "Installation year", "timeUnit": "year", "type": "temporal", "title": "Year", "format": "%Y"},
            {"field": "State", "type": "nominal"},
            {"field": "Installations", "type": "quantitative", "format": ","}
          ],
          "color": {
            "field": "State",
            "type": "nominal",
            "scale": {
              "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT", "ACT/NT", "NSW/ACT"],
              "range": ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b", "#e377c2", "#7f7f7f", "#bcbd22", "#17becf"]
            },
            "legend": null
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "strokeWidth": 2
        },
        "encoding": {
          "x": {
            "field": "Installation year",
            "timeUnit": "year",
            "type": "temporal"
          },
          "y": {
            "field": "Installations",
            "type": "quantitative"
          },
          "color": {
            "field": "State",
            "type": "nominal",
            "scale": {
              "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT", "ACT/NT", "NSW/ACT"],
              "range": ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b", "#e377c2", "#7f7f7f", "#bcbd22", "#17becf"]
            },
            "legend": null
          }
        }
      }
    ]
  },
  "config": {
    "font": "Helvetica Neue, Arial, sans-serif",
    "title": {
      "fontSize": 16,
      "fontWeight": "bold",
      "anchor": "start",
      "color": "#2c3e50",
      "subtitleFontSize": 13,
      "subtitleColor": "#7f8c8d",
      "offset": 15
    },
    "axis": {
      "titleFontSize": 13,
      "labelFontSize": 12,
      "titleColor": "#444",
      "labelColor": "#666",
      "gridColor": "#e0e0e0"
    },
    "legend": {
      "titleFontSize": 13,
      "labelFontSize": 12,
      "titleColor": "#444",
      "labelColor": "#666"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}